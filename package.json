{
  "name": "@tinchu0/knitt",
  "version": "0.1.0-beta.5",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node apps/server/src/main.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "memory": "node packages/adapters/src/command.ts",
    "connect": "node scripts/connector-setup.ts",
    "serve:http": "node apps/server/src/http-main.ts",
    "build": "node scripts/build.ts",
    "test:package": "npm run build && node scripts/package-smoke.ts",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "knitt": "dist/packages/installer/src/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/clients/connector-setup.md",
    "docs/clients/npm-installation.md",
    "LICENSE",
    "docs/clients/local-agent-memory.md",
    "docs/usage.md",
    "docs/clients/support-matrix.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darthnihilus01/knitt.git"
  },
  "description": "Shared conversation memory for coding agents",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "license": "Apache-2.0"
}
